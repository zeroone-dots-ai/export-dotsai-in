    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Verify Razorpay HMAC signature\nconst crypto = require('crypto');\nconst secret = $env.RAZORPAY_WEBHOOK_SECRET;\nconst body = $input.first().binary?.data?.data?.toString() || JSON.stringify($input.first().json);\nconst signature = $input.first().json.headers?.['x-razorpay-signature'];\n\nif (!secret || !signature) {\n  return [{ json: { ok: false, error: 'Missing secret or signature' } }];\n}\n\nconst expected = crypto.createHmac('sha256', secret).update(body).digest('hex');\nconst valid = crypto.timingSafeEqual(Buffer.from(expected), Buffer.from(signature));\n\nif (!valid) {\n  return [{ json: { ok: false, error: 'Invalid signature' } }];\n}\n\n// Parse body and pass through\nconst event = JSON.parse(body);\nreturn [{ json: { ok: true, event } }];"
      },
      "id": "verify-hmac",
      "name": "Verify HMAC",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.event.event }}",
                    "rightValue": "payment.captured",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "captured"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.event.event }}",
                    "rightValue": "payment.failed",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "failed"
            }
          ]
        },
        "options": {}
      },
      "id": "switch-event",
