# export.dotsai.in — environment variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# ─── Convex (real-time backend) ──────────────────────────────────────
# Set automatically by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# ─── Clerk auth ──────────────────────────────────────────────────────
# Get from clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard/onboarding

# ─── Razorpay (payments — India) ─────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ─── Anthropic (Claude API — HS code AI, doc drafting) ────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── VPS PostgreSQL mirror (analytics) ────────────────────────────────
VPS_SYNC_URL=https://db.dotsai.cloud/sync/api/sync/batch
VPS_SYNC_TOKEN=
APP_ID=a12_export-dotsai-in

# ─── MyCloud (S3-compatible, for document storage) ────────────────────
MYCLOUD_ENDPOINT=https://cloud.zeroonedotsai.consulting
MYCLOUD_ACCESS_KEY=
MYCLOUD_SECRET_KEY=
MYCLOUD_BUCKET=d-drive
MYCLOUD_PREFIX=apps/a12_export-dotsai-in/

# ─── Notifications (purpose-routed via meet-workstyle channels) ───────
# Slack — work channel (deals, demos, new leads)
SLACK_WEBHOOK_WORK=
# Telegram — personal (hot leads requiring decision)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Site metadata ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://export.dotsai.in
NEXT_PUBLIC_SITE_NAME="ZeroOne Export"
